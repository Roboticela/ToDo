# Frontend base URL (this app / dev server). Prefer VITE_ prefix so Vite exposes them to the client.
VITE_APP_URL=http://localhost:5173

# Backend API base URL (Express server, etc.)
VITE_API_URL=http://localhost:3000

# Google OAuth Web client ID (same as server GOOGLE_CLIENT_ID).
# Required for native Android/iOS Google account picker (ID token audience).
# Also create an Android OAuth client in Google Cloud Console with package
# com.roboticela.todo + your debug/release SHA-1 (not used in code).
# For iOS, create an iOS OAuth client with the app bundle ID.
VITE_GOOGLE_CLIENT_ID=

# Optional: same values without VITE_ — merged at build time in vite.config.ts (see loadEnv + define).
# APP_URL=http://localhost:5173
# API_URL=http://localhost:3000

# Docker / compose (repo root): baked into the client at image build time.
# WEB_PORT=80
# Example production:
# VITE_APP_URL=https://app.todo.roboticela.com
# VITE_API_URL=https://api.todo.roboticela.com
#
#   docker compose up -d --build
#   docker build --build-arg VITE_APP_URL=... --build-arg VITE_API_URL=... -t todo-web .

# CI / Tauri: GitHub Actions sets these on the job; Tauri beforeBuildCommand runs
# scripts/sync-frontend-env.mjs which writes .env.production for Vite to bake in.
# Set on a GitHub Environment (Settings → Environments → Variables), then pick that
# environment when running the Build and Release workflow.
# Fallbacks: APP_URL / FRONTEND_URL, API_URL / BACKEND_URL
