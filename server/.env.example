# Database
DATABASE_URL="postgresql://user:password@localhost:5432/todo?schema=public"

# JWT
JWT_ACCESS_SECRET=your-access-secret-min-32-chars
JWT_REFRESH_SECRET=your-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Frontend URLs (for redirects and CORS)
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:3000
# Custom protocol for desktop app OAuth callback
APP_DEEP_LINK_SCHEME=roboticela-todo

# Google OAuth (create at https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
# Redirect URIs to register in Google Console:
# - Web: FRONTEND_URL/auth/callback (handled by SPA) or backend callback then redirect
# - We use backend callback then redirect to frontend

# SMTP (Nodemailer)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Roboticela ToDo <noreply@todo.roboticela.com>"

# Email: verification, reminders, unsubscribe
SUBSCRIPTION_REMINDER_INTERVAL_DAYS=7
EMAIL_UNSUBSCRIBE_SECRET=your-unsubscribe-secret-min-32-chars

# Paddle Billing (https://developer.paddle.com/)
PADDLE_API_KEY=your-paddle-api-key
PADDLE_WEBHOOK_SECRET=your-paddle-webhook-secret
# Sandbox: set PADDLE_SANDBOX=true (or PADDLE_ENV=sandbox). Also auto-detected for keys containing _test_.
# PADDLE_SANDBOX=true
# Price IDs from Paddle catalog (Basic $5/mo, $3/mo yearly; Pro $8/mo, $6/mo yearly; Lifetime $79 one-time)
PADDLE_PRICE_ID_BASIC_MONTHLY=pri_xxxx
PADDLE_PRICE_ID_BASIC_YEARLY=pri_xxxx
PADDLE_PRICE_ID_PRO_MONTHLY=pri_xxxx
PADDLE_PRICE_ID_PRO_YEARLY=pri_xxxx
PADDLE_PRICE_ID_LIFETIME=pri_xxxx

# Cloudflare R2 (avatar storage; optional – avatars fall back to Google/URL if unset or misconfigured)
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key
R2_SECRET_ACCESS_KEY=your-r2-secret-key
R2_BUCKET=your-bucket-name
# MUST be a public URL — NOT the S3 API host (*.r2.cloudflarestorage.com).
# Use either:
#   1) Bucket → Settings → Public access → R2.dev subdomain, e.g. https://pub-xxxxx.r2.dev
#   2) A custom domain connected to the bucket, e.g. https://cdn.example.com
# Using https://<accountid>.r2.cloudflarestorage.com causes browser "InvalidArgument" errors.
R2_PUBLIC_URL=https://pub-xxxxx.r2.dev

# Server
PORT=3000
NODE_ENV=development
